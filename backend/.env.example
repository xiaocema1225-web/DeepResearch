# ============ LLM 配置（阿里百炼兼容模式） ============
APP_TOKEN=你的百炼API Key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ============ 检索引擎一：阿里百炼（国内/中文信源） ============
# 用于联网搜索的百炼模型（须支持 enable_search）
BAILIAN_SEARCH_MODEL=qwen-plus
BAILIAN_SEARCH_MAX_QPS=5

# ============ 检索引擎二：Firecrawl（国外/英文信源） ============
# 从 https://www.firecrawl.dev 注册获取
FIRECRAWL_API_KEY=你的Firecrawl API Key
# FIRECRAWL_BASE_URL=https://api.firecrawl.dev   # 自托管时覆盖
FIRECRAWL_SEARCH_MAX_QPS=5
# 是否抓取正文 markdown（true 可获得全文，但消耗更多额度）
FIRECRAWL_SCRAPE_CONTENT=false

# ============ 模型列表（JSON 格式，下发给前端） ============
# Format: [{"model_id":"","display_name":"","icon":"Zap or Cpu","icon_color":"tailwind_color_class"}]
AVAILABLE_MODELS=[{"model_id":"qwen3.6-flash","display_name":"Qwen-Flash","icon":"Zap","icon_color":"yellow-400"},{"model_id":"qwen3.6-plus","display_name":"Qwen-Plus","icon":"Zap","icon_color":"orange-400"},{"model_id":"qwen3.7-max","display_name":"Qwen-Max","icon":"Cpu","icon_color":"purple-400"}]

# ============ 调研深度配置 ============
NUMBER_OF_INITIAL_QUERIES=2
MAX_RESEARCH_LOOPS=2
SEARCH_RESULTS_PER_QUERY=10

# ============ 日志 ============
# LOG_LEVEL=INFO
# LOG_DIR=logs

# ============ LangSmith（可选） ============
# LANGSMITH_API_KEY=你的LangSmith API
